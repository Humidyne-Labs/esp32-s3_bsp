menu "ESP32-S3 Touch ePaper Board Support Package"

    config BSP_BOARD_NAME
        string "Board Name"
        default "ESP32-S3 Touch ePaper 1.54 inch"
        help
            Identifier for the board target.

    config BSP_ENABLE_TOUCH
        bool "Enable touch panel"
        default y
        help
            Initialize the FT6336 touch controller and expose it to LVGL.

    menu "Pinout Configuration"

        config BSP_GPIO_BOOT_KEY
            int "BOOT Switch GPIO"
            default 0

        config BSP_GPIO_BAT_ADC
            int "Battery ADC GPIO"
            default 1

        config BSP_GPIO_PWR_KEY
            int "Power Hold GPIO"
            default 2

        config BSP_GPIO_USER_LED
            int "User Status LED GPIO"
            default 38

        config BSP_GPIO_I2C_SCL
            int "Shared I2C SCL GPIO"
            default 6

        config BSP_GPIO_I2C_SDA
            int "Shared I2C SDA GPIO"
            default 7

        config BSP_GPIO_EPD_DC
            int "Display DC Control GPIO"
            default 8

        config BSP_GPIO_EPD_RST
            int "Display Reset GPIO"
            default 9

        config BSP_GPIO_EPD_CS
            int "Display SPI Chip Select GPIO"
            default 10

        config BSP_GPIO_EPD_SCLK
            int "Display SPI Clock GPIO"
            default 11

        config BSP_GPIO_EPD_MOSI
            int "Display SPI MOSI GPIO"
            default 12

        config BSP_GPIO_EPD_BUSY
            int "Display Busy Status GPIO"
            default 13

        config BSP_GPIO_TOUCH_RST
            int "Touch Panel Reset GPIO"
            default 4

        config BSP_GPIO_TOUCH_INT
            int "Touch Panel Interrupt GPIO"
            default 5

        config BSP_GPIO_SD_CLK
            int "MicroSD Clock GPIO"
            default 39

        config BSP_GPIO_SD_MISO
            int "MicroSD MISO GPIO"
            default 40

        config BSP_GPIO_SD_MOSI
            int "MicroSD MOSI GPIO"
            default 41

        config BSP_GPIO_SD_CS
            int "MicroSD CS GPIO"
            default 42

        config BSP_GPIO_I2S_MCLK
            int "Audio Codec MCLK GPIO"
            default 14

        config BSP_GPIO_I2S_SCLK
            int "Audio Codec SCLK GPIO"
            default 15

        config BSP_GPIO_I2S_LRCK
            int "Audio Codec LRCK GPIO"
            default 16

        config BSP_GPIO_I2S_ASOUT
            int "Audio Codec ASOUT GPIO"
            default 17

        config BSP_GPIO_I2S_DSIN
            int "Audio Codec DSIN GPIO"
            default 18

        config BSP_GPIO_PA_CTRL
            int "Power Amplifier Control GPIO"
            default 47

        config BSP_GPIO_PA_EN
            int "Power Amplifier Enable GPIO"
            default 48

    endmenu

