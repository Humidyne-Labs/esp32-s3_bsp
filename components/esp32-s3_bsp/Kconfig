menu "ESP32-S3 Touch ePaper Board Support Package"

    config BSP_BOARD_NAME
        string "Board Name"
        default "Waveshare ESP32-S3 Touch ePaper 1.54 V2"
        help
            Identifier for the board target.

    config BSP_ENABLE_TOUCH
        bool "Enable touch panel subsystem"
        default y
        help
            Initialize the FT6336 capacitive touch controller and register the LVGL input device.

    config BSP_SHTC3_LOW_POWER
        bool "Use SHTC3 low-power measurement mode"
        default y
        help
            Use the SHTC3 polling, temperature-first low-power measurement command by default.

    config BSP_AUDIO_DEFAULT_VOLUME
        int "Default Audio Volume Percentage (0-100)"
        range 0 100
        default 80
        help
            Default startup volume level for the ES8311 codec and NS4168 amplifier.

    choice BSP_RTC_WAKEUP_SOURCE
        prompt "Deep Sleep Wakeup Timer Source"
        default BSP_RTC_WAKEUP_EXTERNAL_PCF85063
        help
            Select the timer source used for timed deep-sleep wakeups.
            External PCF85063A uses an ultra-low power 32.768kHz crystal (~0.22uA) and wakes up via GPIO 5 interrupt.
            Internal RTC Timer uses the ESP32-S3 internal RTC timer (~7-8uA).

        config BSP_RTC_WAKEUP_EXTERNAL_PCF85063
            bool "External PCF85063A RTC Countdown Timer (0.22uA, Recommended for Battery Life)"
            help
                Uses the external PCF85063A RTC periodic countdown timer on GPIO 5 (RTC_INT)
                to trigger wakeups. Best for preserving battery life on 400mAh cells.

        config BSP_RTC_WAKEUP_INTERNAL_TIMER
            bool "ESP32-S3 Internal RTC Timer (esp_sleep_enable_timer_wakeup)"
            help
                Uses the ESP32-S3 internal sleep timer. Useful if external RTC is unpopulated
                or for sub-second sleep precision.
    endchoice

endmenu