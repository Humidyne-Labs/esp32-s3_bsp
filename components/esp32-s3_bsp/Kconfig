menu "ESP32-S3 ePaper Board Support Package"

    config BSP_BOARD_NAME
        string "Board Name"
        default "Waveshare ESP32-S3 ePaper 1.54 V2"
        help
            Identifier for the board target.

    config BSP_AUDIO_DEFAULT_VOLUME
        int "Default Audio Volume Percentage (0-100)"
        range 0 100
        default 80
        help
            Default startup volume level for the ES8311 codec and NS4168 amplifier.

    config BSP_AUDIO_LOW_POWER_DEFAULT
        bool "Enable ES8311 Low-Power Playback Mode by Default"
        default y
        help
            Enables low power mode on the ES8311 DAC during active playback (Reg 0x0F LPDAC & LPDACVRP bits).
            Reduces active audio current consumption by ~30% while preserving audio quality.

    config BSP_BATTERY_CORRECTION_FACTOR_MV
        int "Battery ADC Voltage Correction Factor (mV)"
        range 0 500
        default 50
        help
            Voltage offset correction factor in millivolts added to battery ADC readings
            to compensate for resistor divider tolerance and hardware calibration offsets.




    choice BSP_RTC_WAKEUP_SOURCE
        prompt "Deep Sleep Wakeup Timer Source"
        default BSP_RTC_WAKEUP_EXTERNAL_PCF85063
        help
            Select the timer source used for timed deep-sleep wakeups.
            External PCF85063A uses an ultra-low power 32.768kHz crystal (~0.22uA) and wakes up via GPIO 5 interrupt.
            Internal RTC Timer uses the ESP32-S3 internal RTC timer (~7-8uA).

        config BSP_RTC_WAKEUP_EXTERNAL_PCF85063
            bool "External PCF85063A RTC Countdown Timer (0.22uA, Recommended for Battery Life)"
            help
                Uses the external PCF85063A RTC periodic countdown timer on GPIO 5 (RTC_INT)
                to trigger wakeups. Best for preserving battery life on 400mAh cells.

        config BSP_RTC_WAKEUP_INTERNAL_TIMER
            bool "ESP32-S3 Internal RTC Timer (esp_sleep_enable_timer_wakeup)"
            help
                Uses the ESP32-S3 internal sleep timer. Useful if external RTC is unpopulated
                or for sub-second sleep precision.
    endchoice

    config BSP_ENABLE_THINGSBOARD
        bool "Enable ThingsBoard IoT Telemetry & MQTT Client (bsp_tb)"
        default n
        help
            Enable ThingsBoard client module (bsp_tb.c/h) and MQTT dependency.
            Disabled by default to minimize binary size and memory footprint.

    config BSP_THERMAL_COMPENSATION_DEFAULT
        bool "Enable Dynamic MCU Thermal & Humidity Compensation by Default"
        default y
        help
            Uses the ESP32-S3 internal die temperature sensor (TSENS) to compensate SHTC3
            temperature and relative humidity for PCB self-heating.

    config BSP_THERMAL_DIVIDER_K_X1000
        int "Thermal Coupling Ratio K (x1000)"
        range 0 2000
        default 380
        depends on BSP_THERMAL_COMPENSATION_DEFAULT
        help
            Thermal resistance coupling ratio K = R_amb / R_pcb multiplied by 1000.
            Default 380 represents K = 0.380, calibrated for 53mm x 40mm 4-6 layer PCB stackup.

    config BSP_THERMAL_EMA_ALPHA_X1000
        int "MCU Die Temp EMA Filter Weight Alpha (x1000)"
        range 1 1000
        default 50
        depends on BSP_THERMAL_COMPENSATION_DEFAULT
        help
            Exponential Moving Average (EMA) low-pass filter weight multiplied by 1000.
            Default 50 represents alpha = 0.050 (low-pass filter to smooth CPU junction thermal spikes).

endmenu